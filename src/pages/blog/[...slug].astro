---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PostHeader from '../../components/blog/PostHeader.astro';
import ReadingProgress from '../../components/blog/ReadingProgress.astro';
import { reader } from '../../lib/reader';
import { shouldShowAiAssistedMessage } from '../../lib/aiDisclosure';
import { estimateReadingTime } from '../../lib/reading';
import Markdoc from '@markdoc/markdoc';
import '../../styles/prose.css';

export async function getStaticPaths() {
  let posts = await reader.collections.posts.all();

  if (import.meta.env.PROD) {
    posts = posts.filter(p => !p.entry.draft);
  }

  return posts.map(post => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const { slug } = Astro.props as { slug: string };
const post = await reader.collections.posts.read(slug);

if (!post) {
  return Astro.redirect('/404');
}

// Render markdoc content: content field is a ContentFormField, so ValueForReading is () => Promise<{ node }>
const contentResult = await post.content();
const renderable = Markdoc.transform(contentResult.node);
const contentHtml = Markdoc.renderers.html(renderable);

// Calculate reading time at an average adult reading speed.
const plainText = contentHtml.replace(/<[^>]*>/g, '');
const wordCount = plainText.trim().split(/\s+/).filter(Boolean).length;
const readingTime = estimateReadingTime(wordCount);
const showAiAssistedMessage = shouldShowAiAssistedMessage(post.showAiAssistedMessage);
---

<BaseLayout title={`${post.title} — Ryan McGovern`} description={post.description}>
  <ReadingProgress />
  <div class="post-page">
    <div class="post-inner">
      <PostHeader
        title={post.title}
        date={post.date ?? ''}
        tags={post.tags as string[]}
        image={post.image ?? null}
        description={post.description}
        readingTime={readingTime}
      />
      {showAiAssistedMessage && (
        <aside class="ai-assisted-message" aria-label="AI assistance disclosure">
          This post was created with AI assistance. <a href="/ai">Read how I use AI.</a>
        </aside>
      )}
      <article class="prose" data-reading-content set:html={contentHtml} />
    </div>
  </div>
</BaseLayout>

<style>
  .post-page {
    padding: 3rem 1.5rem 4rem;
  }

  .post-inner {
    max-width: var(--prose-width);
    margin: 0 auto;
  }

  .ai-assisted-message {
    margin: 0 0 2rem;
    padding: 0.875rem 1rem;
    color: var(--text);
    background: var(--surface);
    border: var(--border-width) solid var(--border);
    box-shadow: var(--shadow);
    font-family: var(--font-body);
    line-height: var(--line-height-body);
  }

  .ai-assisted-message a {
    color: var(--link);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .ai-assisted-message a:hover {
    color: var(--link-hover);
  }

</style>
